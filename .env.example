# Export settings in your shell. This file is not loaded automatically.
MATCHDAY_SOURCE=auto
MATCHDAY_PROVIDER=api-football
MATCHDAY_OFFLINE=false
MATCHDAY_SEASON=auto
MATCHDAY_COMPETITIONS=PL,PD,BL1,SA,FL1
MATCHDAY_REFRESH_HOURS=24
MATCHDAY_REQUESTS_PER_MINUTE=10
MATCHDAY_POLL_SECONDS=0
MATCHDAY_MODEL_THREADS=2
# Enter an API-Football key in Data & connection, or export API_FOOTBALL_KEY.
# Legacy mode uses MATCHDAY_PROVIDER=football-data and FOOTBALL_API_KEY.
# MATCHDAY_DB_PATH and MATCHDAY_MODEL_CACHE optionally override local paths.
# Do not commit credential values to this file.
