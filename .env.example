# Copy this file to .env and the app will load it automatically on startup.
# .env itself is git-ignored, so real keys never get committed from here.
# The "Remember this key on this computer" checkbox in Data & connection
# writes to .env for you after a key verifies, so most users never need to
# edit this file by hand — it's here for anyone who prefers to set it up
# manually, or to export these as shell variables instead (either way, an
# already-exported environment variable always wins over .env's contents).
MATCHDAY_SOURCE=auto
MATCHDAY_PROVIDER=football-data
MATCHDAY_OFFLINE=false
MATCHDAY_SEASON=auto
MATCHDAY_COMPETITIONS=PL,PD,BL1,SA,FL1
MATCHDAY_REFRESH_HOURS=24
MATCHDAY_REQUESTS_PER_MINUTE=10
MATCHDAY_POLL_SECONDS=0
MATCHDAY_MODEL_THREADS=2
# Enter a football-data.org key in Data & connection, or export FOOTBALL_API_KEY.
# MATCHDAY_DB_PATH and MATCHDAY_MODEL_CACHE optionally override local paths.
# Do not commit credential values to this file.
